{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "timezone": "Europe/Paris",
  "schedule": ["after 10pm every weekday", "before 5am every weekday", "every weekend"],
  "automerge": false,
  "major": {
    "automerge": false
  },
  "minor": {
    "automerge": false
  },
  "patch": {
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Auto-update Docker images in Helm charts",
      "matchDatasources": ["docker"],
      "matchManagers": ["regex"],
      "automerge": false,
      "labels": ["docker", "helm"]
    },
    {
      "description": "GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "labels": ["github-actions"]
    }
  ],
  "regexManagers": [
    {
      "description": "Update appVersion in Chart.yaml from Docker images",
      "fileMatch": ["^charts/.+/Chart\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s+appVersion: [\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    }
  ]
}
